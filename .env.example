# ---- proxy-router (C-Node) ----
WALLET_PRIVATE_KEY=0x<your_consumer_wallet_private_key>
ETH_NODE_ADDRESS=https://base-mainnet.g.alchemy.com/v2/<your_alchemy_key>
# Chain ID / Diamond / MOR token are baked into compose (Base mainnet).

# ---- shared: router admin credentials ----
# Same value feeds the router (its cookie auth) and uplink (to call the
# router). SecretVM / generic compose use COOKIE_CONTENT; local also accepts
# ROUTER_AUTH as a fallback name for the same user:password string.
COOKIE_CONTENT=admin:<strong_password>
ROUTER_AUTH=admin:<strong_password>

# ---- uplink ----
ADMIN_PASSWORD=<gui_admin_password>
# Master API key is derived from this seed (HMAC) - same seed after a
# storage wipe means the same sk- key keeps working. Generate with:
#   openssl rand -hex 32
API_KEY_SEED=<random_hex_seed>

# ---- Optional tuning (defaults shown) ----
# How long each pooled session lasts. Stake escrowed per session scales
# with duration; shorter = less MOR locked at once but more session-open
# waits, longer = smoother but more stake held by open sessions.
#SESSION_DURATION_SECONDS=600
# Let the router pick another provider if the chosen one fails mid-open.
#SESSION_FAILOVER=true
# Catalog used to resolve model names ("llama-3.3-70b") to on-chain model
# IDs and to serve /v1/models. Default is gateway_models.json (includes
# bidDetail for list/open). Override only for testnet or a self-hosted
# catalog mirror. Do not use active_models.json / ALL feeds here.
#ACTIVE_MODELS_URL=https://active.mor.org/gateway_models.json
# Companion bids feed (gateway_bids.json). Catalog list/open uses bidDetail
# on ACTIVE_MODELS_URL as primary; this URL is for mirrors/ops.
#GATEWAY_BIDS_URL=https://active.mor.org/gateway_bids.json
# Uplink also reads ETH_NODE_ADDRESS (above) to show daylocked / on-hold MOR.
# Set WALLET_PRIVATE_KEY on uplink too (same key as the router) to enable
# post-midnight reclaim: close past-end sessions + withdrawUserStakes
# (same job as the Infra consumer_wallet_housekeeping Lambda). Disable with
# HOUSEKEEPING=false.
# Days of usage history kept by admin disk prune (default 30).
#USAGE_PRUNE_DAYS=30
