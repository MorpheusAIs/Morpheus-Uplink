# ---- 1. Minimum to run (six operator fillables; SecretVM / generic / Railway) ----
# Router-only (Uplink reclaim goes through router; Uplink holds no wallet key).
WALLET_PRIVATE_KEY=0x<your_consumer_wallet_private_key>
ETH_NODE_ADDRESS=https://base-mainnet.g.alchemy.com/v2/<your_alchemy_key>
# Same value feeds the router (its cookie auth) and uplink (to call the
# router). SecretVM / generic compose use COOKIE_CONTENT; local also accepts
# ROUTER_AUTH as a fallback name for the same user:password string.
COOKIE_CONTENT=admin:<strong_password>
ROUTER_AUTH=admin:<strong_password>
ADMIN_PASSWORD=<gui_admin_password>
# Master API key is derived from this seed (HMAC) - same seed after a
# storage wipe means the same sk- key keeps working. Generate with:
#   openssl rand -hex 32
API_KEY_SEED=<random_hex_seed>
# Public HTTPS (or http://localhost:8080 for local). SecretVM / Railway /
# generic require this; local compose bakes http://localhost:8080.
WEB_PUBLIC_URL=http://localhost:8080

# Tunables are not Encrypted Secrets / operator forms. docker-compose.local.yml
# takes them as env-overridable defaults: uncomment to override.
#
# ---- 2. Uplink tunable / additional (Uplink process only; see internal/config) ----
# SESSION_DURATION_SECONDS=600
# SESSION_FAILOVER=true
# ACTIVE_MODELS_URL=https://active.mor.org/gateway_models.json
# GATEWAY_BIDS_URL=https://active.mor.org/gateway_bids.json
# HOUSEKEEPING=true
# Wiring defaults: UPLINK_LISTEN, ROUTER_URL, DATA_DIR, USAGE_PRUNE_DAYS,
#   SESSION_DIRECT_PAYMENT, CLOSE_SESSIONS_ON_EXIT
#USAGE_PRUNE_DAYS=30
# Diamond / ETH_NODE_CHAIN_ID may exist in Uplink config defaults but are
# NOT operator knobs for Uplink.
#
# ---- 3. Router tunable / additional (proxy-router only; router_network_env) ----
# Process env wins over godotenv. PROXY_* / LOG_LEVEL_* are router-only.
# PROXY_STORE_CHAT_CONTEXT=false
# PROXY_FORWARD_CHAT_CONTEXT=false
# LOG_LEVEL_APP=warn
# LOG_LEVEL_TCP=warn
# LOG_LEVEL_ETH_RPC=warn
# ETH_NODE_USE_SUBSCRIPTIONS=false
#   Also: ETH_NODE_CHAIN_ID, BLOCKSCOUT_API_URL, DIAMOND_CONTRACT_ADDRESS,
#   MOR_TOKEN_ADDRESS
