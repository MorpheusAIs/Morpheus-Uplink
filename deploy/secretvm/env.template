# UPLINK SecretVM secrets - paste as Encrypted Secrets (or fill the form
# SecretVM auto-builds from the five environment substitutions).
#
# Replace every YOUR_* / PASTE_* value. Generate the seed with:
#   openssl rand -hex 32
#
# Required (5) -- these are the ONLY keys the Encrypted Secrets form should show:
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ETH_NODE_ADDRESS=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
COOKIE_CONTENT=admin:YOUR_STRONG_PASSWORD
ADMIN_PASSWORD=YOUR_GUI_PASSWORD
API_KEY_SEED=PASTE_openssl_rand_hex_32_HERE

# Not Encrypted Secrets (baked in compose configs: router_network_env):
#   WEB_PUBLIC_URL=https://localhost
#   SESSION_DURATION_SECONDS=600
#   PROXY_* / LOG_LEVEL_* privacy defaults
#   Base chain ID / Diamond / MOR
# After first boot, set the real host by editing WEB_PUBLIC_URL in the compose
# configs block (e.g. https://your-vm-name.vm.scrtlabs.com) and redeploy -- do
# not add it to Encrypted Secrets (SecretVM scrapes every environment: key).
