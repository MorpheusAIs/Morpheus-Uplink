# UPLINK SecretVM secrets - paste as Encrypted Secrets when creating the VM.
# These 5 lines are ALL the deployment needs; everything else is baked into
# the compose/images. Fill in the wallet key and RPC URL; the generated
# values below are ready to use.

# 1. Consumer wallet private key (MOR + ETH on Base mainnet). Stays in the enclave.
WALLET_PRIVATE_KEY=0x<YOUR_PRIVATE_KEY>

# 2. Base mainnet RPC (Alchemy/Infura).
ETH_NODE_ADDRESS=https://base-mainnet.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>

# 3. Router admin credentials, shared by the router (its cookie auth) and
#    uplink (to call the router). Format user:pass.
COOKIE_CONTENT=admin:eec97313a10a6cc2e3b901165e078e2b

# 4. GUI/admin login password (username: admin).
ADMIN_PASSWORD=a6617b7f9c07715cc8813e4ad3c5f2e2

# 5. Seed for deterministic API keys - SAVE THIS. Same seed after a VM
#    rebuild regenerates the same master/prompt keys.
API_KEY_SEED=1256b9c42abacf889ac80d2f6e8669effc0a75634b21f1a6de873107401a9e17

# Optional (not a secret): your VM's public URL + /node, so the router's
# swagger links point at the right place. Example:
# WEB_PUBLIC_URL=https://your-vm-name.vm.scrtlabs.com/node
