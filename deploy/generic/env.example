# Uplink generic VPS / Docker host - copy to .env and fill in.
# Compose: docker-compose.generic.deployed.yml from the GitHub release
# (or deploy/generic/docker-compose.yml). Images pull from ghcr.io.

# DNS name pointed at this machine (Caddy Let's Encrypt). Required for TLS.
PUBLIC_HOST=uplink.yourdomain.com

# ---- 1. Minimum to run (six operator fillables; same across SecretVM / Railway) ----
# Router-only (Uplink reclaim goes through router; Uplink holds no wallet key).
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ETH_NODE_ADDRESS=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Same user:password for router cookie auth and uplink->router calls.
COOKIE_CONTENT=admin:YOUR_STRONG_PASSWORD
ADMIN_PASSWORD=YOUR_GUI_PASSWORD
# Generate: openssl rand -hex 32
API_KEY_SEED=PASTE_HEX_SEED_HERE
# Public HTTPS origin (usually https://$PUBLIC_HOST).
WEB_PUBLIC_URL=https://uplink.yourdomain.com

# Tunables change via compose/code only -- not this .env form surface.
#
# ---- 2. Uplink tunable / additional (Uplink process only) ----
#   ACTIVE_MODELS_URL, GATEWAY_BIDS_URL, SESSION_DURATION_SECONDS,
#   SESSION_FAILOVER, HOUSEKEEPING
# Wiring defaults: UPLINK_LISTEN, ROUTER_URL, DATA_DIR, USAGE_PRUNE_DAYS,
#   CLOSE_SESSIONS_ON_EXIT
# Diamond / ETH_NODE_CHAIN_ID are NOT Uplink operator knobs.
#
# ---- 3. Router tunable / additional (proxy-router only) ----
#   PROXY_STORE_CHAT_CONTEXT, PROXY_FORWARD_CHAT_CONTEXT
#   LOG_LEVEL_APP, LOG_LEVEL_TCP, LOG_LEVEL_ETH_RPC
#   ETH_NODE_CHAIN_ID, ETH_NODE_USE_SUBSCRIPTIONS, BLOCKSCOUT_API_URL
#   DIAMOND_CONTRACT_ADDRESS, MOR_TOKEN_ADDRESS
# NEVER describe router PROXY_* / LOG_LEVEL_* as Uplink knobs.

# MOR allowance: the gateway's router user can only open inference sessions;
# it cannot send MOR or ETH, change approvals, or read the wallet key. A
# session stake is locked while the session runs and is returned to this
# wallet, held at most until the next UTC day. Sessions cost ETH gas.
# Empty: the gateway may lock up to the live wallet MOR balance (new deposits
# are included within ~2 min). Set a value in wei to cap how much MOR it can
# lock in total; 0 disables session opening.
# Note: the router also supports "direct payment" sessions, where the
# provider is paid from the stake (at most getTodaysBudget / totalMORSupply
# of it, about 0.3% today). The gateway itself never uses it, but whoever
# holds the router credential could. A cap bounds that worst case to the
# same fraction of the cap. High-value wallets: set a cap.
# Example cap: 1000 MOR
# UPLINK_MOR_ALLOWANCE_WEI=1000000000000000000000
UPLINK_MOR_ALLOWANCE_WEI=

# Admin auth (v7.15 hardening)
ADMIN_2FA_REQUIRED=true
MASTER_KEY_ADMIN=false
# UPLINK_RESET_2FA=false
# TRUSTED_PROXY_CIDR=
