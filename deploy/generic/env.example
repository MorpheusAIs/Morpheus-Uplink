# Uplink generic VPS / Docker host - copy to .env and fill in.
# Compose: docker-compose.generic.deployed.yml from the GitHub release
# (or deploy/generic/docker-compose.yml). Images pull from ghcr.io.

# DNS name pointed at this machine (Caddy Let's Encrypt). Required for TLS.
PUBLIC_HOST=uplink.yourdomain.com

# ---- 1. Minimum to run (six operator fillables; same across SecretVM / Railway) ----
# Router-only (Uplink reclaim goes through router; Uplink holds no wallet key).
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ETH_NODE_ADDRESS=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# Same user:password for router cookie auth and uplink->router calls.
COOKIE_CONTENT=admin:YOUR_STRONG_PASSWORD
ADMIN_PASSWORD=YOUR_GUI_PASSWORD
# Generate: openssl rand -hex 32
API_KEY_SEED=PASTE_HEX_SEED_HERE
# Public HTTPS origin (usually https://$PUBLIC_HOST).
WEB_PUBLIC_URL=https://uplink.yourdomain.com

# Tunables are env-overridable compose defaults: leave commented for the
# default, uncomment to override. Not part of the six operator fillables.
#
# ---- 2. Uplink tunable / additional (Uplink process only) ----
# SESSION_DURATION_SECONDS=600
# SESSION_FAILOVER=true
# ACTIVE_MODELS_URL=https://active.mor.org/gateway_models.json
# GATEWAY_BIDS_URL=https://active.mor.org/gateway_bids.json
# HOUSEKEEPING=true
# Wiring defaults: UPLINK_LISTEN, ROUTER_URL, DATA_DIR, USAGE_PRUNE_DAYS,
#   CLOSE_SESSIONS_ON_EXIT
# Diamond / ETH_NODE_CHAIN_ID are NOT Uplink operator knobs.
#
# ---- 3. Router tunable / additional (proxy-router only) ----
# PROXY_STORE_CHAT_CONTEXT=false
# PROXY_FORWARD_CHAT_CONTEXT=false
# LOG_LEVEL_APP=warn
# LOG_LEVEL_TCP=warn
# LOG_LEVEL_ETH_RPC=warn
# ETH_NODE_USE_SUBSCRIPTIONS=false
#   Also: ETH_NODE_CHAIN_ID, BLOCKSCOUT_API_URL, DIAMOND_CONTRACT_ADDRESS,
#   MOR_TOKEN_ADDRESS
# NEVER describe router PROXY_* / LOG_LEVEL_* as Uplink knobs.

# Session stake: locked while the session runs and returned to this wallet,
# held at most until the next UTC day (a lock, not a spend). Sessions cost
# ETH gas. Uplink only opens staking-mode sessions.

# Admin auth. Compose defaults shown; turning 2FA off or the master key
# admin access on weakens admin security.
ADMIN_2FA_REQUIRED=true
MASTER_KEY_ADMIN=false
# Break-glass: set true for ONE restart to wipe 2FA, then remove it.
# UPLINK_RESET_2FA=false
