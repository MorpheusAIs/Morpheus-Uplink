# Railway overlay - copy meanings into Railway Variables.
# Mark the H4 secret-class entries as Railway Secrets (not plain vars,
# not railway.toml, not image labels, not build args).

# ---- 1. Minimum to run (six operator fillables; same across SecretVM / generic) ----
WALLET_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
ETH_NODE_ADDRESS=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
COOKIE_CONTENT=admin:YOUR_STRONG_PASSWORD
ADMIN_PASSWORD=YOUR_GUI_PASSWORD
API_KEY_SEED=PASTE_openssl_rand_hex_32_HERE
# After first deploy, set to your Railway HTTPS origin:
WEB_PUBLIC_URL=https://your-service.up.railway.app

# Tunables change via compose/code only -- not Railway Secrets form surface.
#
# ---- 2. Uplink tunable / additional (Uplink process only) ----
#   ACTIVE_MODELS_URL, GATEWAY_BIDS_URL, SESSION_DURATION_SECONDS,
#   SESSION_FAILOVER, HOUSEKEEPING
# Wiring defaults: UPLINK_LISTEN, ROUTER_URL, DATA_DIR, USAGE_PRUNE_DAYS,
#   SESSION_DIRECT_PAYMENT, CLOSE_SESSIONS_ON_EXIT
# Diamond / ETH_NODE_CHAIN_ID are NOT Uplink operator knobs.
#
# ---- 3. Router tunable / additional (proxy-router only) ----
#   PROXY_STORE_CHAT_CONTEXT, PROXY_FORWARD_CHAT_CONTEXT
#   LOG_LEVEL_APP, LOG_LEVEL_TCP, LOG_LEVEL_ETH_RPC
#   ETH_NODE_CHAIN_ID, ETH_NODE_USE_SUBSCRIPTIONS, BLOCKSCOUT_API_URL
#   DIAMOND_CONTRACT_ADDRESS, MOR_TOKEN_ADDRESS
# NEVER describe router PROXY_* / LOG_LEVEL_* as Uplink knobs.
